      <Link>Module\Config\ConfigComponentSystem.cs</Link>
    </Compile>

    <Compile Include="..\..\Unity\Codes\Hotfix\Module\AI\**\*.cs">
      <Link>Module\AI\%(RecursiveDir)%(FileName)%(Extension)</Link>
